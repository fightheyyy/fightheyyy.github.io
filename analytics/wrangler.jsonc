{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "fightheyyy-blog-traffic",
  "account_id": "6afaca4768c145daa4951453847e5c41",
  "main": "worker.js",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "vars": { "SITE_ORIGIN": "https://fightheyyy.github.io" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fightheyyy-blog-traffic",
      "database_id": "bae9dc87-9119-4cd6-8344-8f90372e6ee3",
      "migrations_dir": "migrations"
    }
  ]
}
