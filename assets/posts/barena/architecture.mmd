%% Barena reader map — three product entries, one runtime boundary, evidence-backed judgment
flowchart LR
    subgraph Entry["1 · PRODUCT ENTRY"]
        direction TB
        Explore["Explore<br/>find unknown boundaries"]
        Replay["Replay<br/>protect known behavior"]
        Compare["Compare<br/>baseline vs candidate"]
    end

    subgraph Method["2 · TEST METHOD"]
        direction TB
        UserCat["UserCat<br/>multi-turn user simulation"]
        FixedCase["Fixed Case<br/>repeatable task + assertions"]
        PairedPlan["Paired plan<br/>same task · isolated attempts"]
    end

    subgraph Runtime["3 · RUNTIME BOUNDARY"]
        direction TB
        Adapter["Runtime / Target Adapter<br/>session · turn · cancellation"]
        Targets["Target Agent<br/>XiaoBaOS · OpenClaw · Portable CLI"]
        Adapter --> Targets
    end

    subgraph Evidence["4 · EXECUTION EVIDENCE"]
        direction TB
        Trace["OTel / OTLP Trace<br/>runtime + boundary provenance"]
        Outcome["Artifact + Verifier<br/>observable final state"]
    end

    subgraph Judgment["5 · EVALUATION RESULT"]
        direction TB
        Review["InspectorCat + ReviewerCat<br/>failure analysis + score"]
        Result["Explore report / RunSet<br/>cleared · held · rejected"]
        Review --> Result
    end

    Explore --> UserCat
    Replay --> FixedCase
    Compare --> PairedPlan
    UserCat --> Adapter
    FixedCase --> Adapter
    PairedPlan --> Adapter
    Targets --> Trace
    Targets --> Outcome
    Trace --> Review
    Outcome --> Review

    classDef entry fill:#eef2ff,stroke:#0645ff,color:#10205f,stroke-width:2px;
    classDef method fill:#f7f6f1,stroke:#8d8a80,color:#171715,stroke-width:1.5px;
    classDef runtime fill:#fff7ed,stroke:#c25c16,color:#632d0a,stroke-width:1.5px;
    classDef evidence fill:#edf7f1,stroke:#3f765e,color:#183327,stroke-width:1.5px;
    classDef result fill:#171715,stroke:#171715,color:#ffffff,stroke-width:2px;

    class Explore,Replay,Compare entry;
    class UserCat,FixedCase,PairedPlan method;
    class Adapter,Targets runtime;
    class Trace,Outcome evidence;
    class Review method;
    class Result result;

    style Entry fill:#ffffff,stroke:#d8d6cf,stroke-width:1px
    style Method fill:#ffffff,stroke:#d8d6cf,stroke-width:1px
    style Runtime fill:#ffffff,stroke:#d8d6cf,stroke-width:1px
    style Evidence fill:#ffffff,stroke:#d8d6cf,stroke-width:1px
    style Judgment fill:#ffffff,stroke:#d8d6cf,stroke-width:1px
